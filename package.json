{
  "name": "claude-narrator",
  "version": "0.6.0",
  "description": "A local, zero-dependency live viewer for what Claude Code is doing right now. Tails your own .claude session transcripts, no API calls, no extra token cost.",
  "main": "desktop/main.js",
  "bin": {
    "claude-narrator": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist:win": "electron-builder --win"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chrissierra.claude-narrator",
    "productName": "claude-narrator",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "viewer/**/*",
      "lib/**/*",
      "server.js",
      "package.json",
      "!dist-desktop"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
