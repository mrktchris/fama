{
  "name": "pico",
  "version": "0.9.0",
  "description": "A quick pico of what your Claude Code agent is thinking, live, as it works. Local-first, zero required API calls, optional cloud voice with a persona/accent you control.",
  "main": "desktop/main.js",
  "bin": {
    "pico": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:win-dir": "electron-builder --win dir --publish never",
    "generate-icon": "powershell -ExecutionPolicy Bypass -File desktop/generate-icon.ps1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrktchris/pico.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.chrissierra.pico",
    "productName": "Pico",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "viewer/**/*",
      "lib/**/*",
      "server.js",
      "package.json",
      "!dist-desktop"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "mrktchris",
      "repo": "pico"
    }
  }
}
