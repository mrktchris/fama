# Copy this file to .env in the same folder and fill in your own key to
# upgrade from the free browser voice to OpenAI text-to-speech.
#
#   copy .env.example .env
#
# Then restart the server (Stop-Process the running node, npm start again).
# .env is already in .gitignore, the real key never gets committed.
# Leave OPENAI_API_KEY blank (or delete this file) to stay on the free,
# zero-cost browser voice, that path always keeps working regardless.

OPENAI_API_KEY=

# Optional. gpt-4o-mini-tts is required for voice-style instructions:
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_VOICE_STYLE=Dominican
